# ── LLM Provider ─────────────────────────────────────────────────────────────
# "openai" or "ollama"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-demo-replace-with-your-openai-key
OPENAI_MODEL=gpt-4o

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── SAP Cloud ALM ─────────────────────────────────────────────────────────────
SAP_ALM_BASE_URL=https://demo-tenant.alm.cloud.sap
SAP_ALM_CLIENT_ID=sb-demo-client-id
SAP_ALM_CLIENT_SECRET=demo-client-secret-replace-me
SAP_ALM_TOKEN_URL=https://demo-tenant.authentication.eu10.hana.ondemand.com/oauth/token

# SAP Cloud ALM Automation Runbook IDs
# Find in: SAP Cloud ALM → Intelligent Event Processing → Automation
ALM_RUNBOOK_SYSTEM_NO_ROLL=rb-system-no-roll-fix
ALM_RUNBOOK_RFC_TIMEOUT=rb-rfc-timeout-fix
ALM_RUNBOOK_JOB_FAILED=rb-job-failed-fix
ALM_RUNBOOK_IDOC_ERROR=rb-idoc-error-fix
ALM_RUNBOOK_INTERFACE_TIMEOUT=rb-interface-timeout-fix

# ── SAP RFC Direct Connection (on-prem / RISE private) ───────────────────────
SAP_HOST=sap-prd.your-company.com
SAP_SYSNR=00
SAP_CLIENT=100
SAP_RFC_USER=RFC_HEALING_USR
SAP_RFC_PASS=demo-rfc-password-replace-me
SAP_RFC_DEST=RFC_PROD

# ── SAP Event Mesh (BTP) ─────────────────────────────────────────────────────
EVENT_MESH_URL=https://enterprise-messaging-pubsub.cfapps.eu10.hana.ondemand.com
EVENT_MESH_TOKEN_URL=https://demo-subaccount.authentication.eu10.hana.ondemand.com/oauth/token
EVENT_MESH_CLIENT_ID=sb-demo-event-mesh-client
EVENT_MESH_CLIENT_SECRET=demo-event-mesh-secret-replace-me
EVENT_MESH_QUEUE=sap/healing/alerts

# ── Webhook ───────────────────────────────────────────────────────────────────
# Configure this secret in SAP Cloud ALM → Alert Notification → Webhook
WEBHOOK_SECRET=sap-healing-webhook-secret-demo

# ── ServiceNow ────────────────────────────────────────────────────────────────
# Get free dev instance: https://developer.servicenow.com
SNOW_INSTANCE=dev12345.service-now.com
SNOW_USER=admin
SNOW_PASS=Admin@1234
SNOW_ASSIGNMENT_GROUP=SAP-BASIS-TEAM

# ── Policy / Guardrails ───────────────────────────────────────────────────────
AUTO_CLOSE_CONFIDENCE=0.85
MIN_CONFIDENCE_PRD=0.90
MIN_CONFIDENCE_DEV=0.75
PRD_SYSTEMS=PRD,P01,PROD
MANUAL_ONLY_CODES=AUTH_FAILURE,SECURITY_ALERT
CHANGE_FREEZE=false
BUSINESS_HOURS_ONLY=false
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18

# ── API ───────────────────────────────────────────────────────────────────────
API_SECRET_TOKEN=demo-api-token-replace-me

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./data/chroma
ANONYMIZED_TELEMETRY=False
