# LLM Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Ollama (local Claude-compatible open source)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# SAP ALM / Cloud ALM API
SAP_ALM_BASE_URL=https://your-tenant.alm.cloud.sap
SAP_ALM_CLIENT_ID=your-client-id
SAP_ALM_CLIENT_SECRET=your-client-secret
SAP_ALM_TOKEN_URL=https://your-tenant.authentication.sap.hana.ondemand.com/oauth/token

# ChromaDB vector store path
CHROMA_DB_PATH=./data/chroma

# Auto-close tickets when confidence >= this threshold (0.0 - 1.0)
AUTO_CLOSE_CONFIDENCE=0.85
